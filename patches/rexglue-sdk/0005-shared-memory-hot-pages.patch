+void SharedMemory::FlushWatchedHotPages() {
+  if (watched_hot_pages_.empty()) {
+    return;
+  }
+  // Without the lock: protecting takes it.
+  std::sort(watched_hot_pages_.begin(), watched_hot_pages_.end());
+  for (size_t i = 0; i < watched_hot_pages_.size();) {
+    size_t run_end = i + 1;
+    while (run_end < watched_hot_pages_.size() &&
+           watched_hot_pages_[run_end] == watched_hot_pages_[run_end - 1] + 1) {
+      ++run_end;
+    }
+    if (write_listener_registered_) {
+      write_watch_.WatchPhysicalWrites({watched_hot_pages_[i] << page_size_log2_,
+                                        static_cast<u32>(run_end - i) << page_size_log2_});
+    }
+    i = run_end;
+  }
+  // Writes from now on are reported. One made since the last comparison, while the page was
+  // already watched, shows as a difference from the shadow copy.
+  const size_t page_size = static_cast<size_t>(1) << page_size_log2_;
+  auto lock = AcquireLock();
+  for (const u32 page : watched_hot_pages_) {
+    const u8* guest = GetPhysicalForRead(physical_memory_, page << page_size_log2_,
+                                         static_cast<u32>(page_size));
+    if (!guest || std::memcmp(guest, GetHotPageShadow(page), page_size) != 0) {
+      FireWatchesLocked(page, page, false);
+    }
+    hot_page_shadow_free_slots_.push_back(page_shadow_slot_[page]);
+    page_shadow_slot_[page] = kNoShadow;
+  }
+  watched_hot_pages_.clear();
 }
 
