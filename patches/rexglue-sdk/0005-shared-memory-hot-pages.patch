+void SharedMemory::EnableHotPages() {
+  const u32 page_count = kBufferSize >> page_size_log2_;
+  auto lock = AcquireLock();
+  hot_pages_.assign(num_system_page_flags_, 0);
+  page_last_request_frame_.assign(page_count, 0);
+  page_last_change_frame_.assign(page_count, 0);
+  page_upload_streak_.assign(page_count, 0);
+  page_watch_count_.assign(page_count, 0);
+  page_shadow_slot_.assign(page_count, kNoShadow);
+  hot_pages_enabled_ = true;
+}
+
+u8* SharedMemory::GetHotPageShadow(u32 page) {
+  const u32 slot = page_shadow_slot_[page];
+  REX_ASSERT(slot != kNoShadow);
+  return hot_page_shadow_slabs_[slot >> kHotPageSlabPagesLog2].get() +
+         (static_cast<size_t>(slot & ((1u << kHotPageSlabPagesLog2) - 1)) << page_size_log2_);
+}
+
+u32 SharedMemory::AllocateHotPageShadow() {
+  if (!hot_page_shadow_free_slots_.empty()) {
+    const u32 slot = hot_page_shadow_free_slots_.back();
+    hot_page_shadow_free_slots_.pop_back();
+    return slot;
+  }
+  if ((hot_page_shadow_slots_used_ >> kHotPageSlabPagesLog2) >= hot_page_shadow_slabs_.size()) {
+    hot_page_shadow_slabs_.push_back(std::make_unique_for_overwrite<u8[]>(
+        static_cast<size_t>(1) << (kHotPageSlabPagesLog2 + page_size_log2_)));
+  }
+  return hot_page_shadow_slots_used_++;
+}
+
+void SharedMemory::MakePageNotHot(u32 page, bool free_shadow) {
+  hot_pages_[page >> 6] &= ~(static_cast<u64>(1) << (page & 63));
+  --hot_page_count_;
+  page_upload_streak_[page] = 0;
+  if (free_shadow) {
+    hot_page_shadow_free_slots_.push_back(page_shadow_slot_[page]);
+    page_shadow_slot_[page] = kNoShadow;
+  }
+}
+
+void SharedMemory::AdvanceHotPageFrame() {
+  if (!hot_pages_enabled_) {
+    return;
+  }
+  FlushWatchedHotPages();
+  ++hot_page_frame_;
+  if (!hot_page_count_ || (hot_page_frame_ % kHotPageSweepFrames)) {
+    return;
+  }
+  // Hot pages are compared, and made normal when static, only when they are requested: here
+  // the ones that are no longer requested.
+  for (u32 block = 0; block < hot_pages_.size(); ++block) {
+    u64 bits = hot_pages_[block];
+    u32 bit;
+    while (rex::bit_scan_forward(bits, &bit)) {
+      bits &= ~(static_cast<u64>(1) << bit);
+      const u32 page = (block << 6) + bit;
+      if (hot_page_frame_ - page_last_request_frame_[page] > kHotPageUnchangedFrames) {
+        MakePageNotHot(page, true);
+      }
+    }
+  }
+}
+
+bool SharedMemory::CopyPagesForUpload(u8* dst, u32 page_first, u32 page_count) {
+  const u8* source = GetPhysicalForRead(physical_memory_, page_first << page_size_log2_,
+                                        page_count << page_size_log2_);
+  if (!source) {
+    return false;
+  }
+  if (!hot_pages_enabled_ || !hot_page_count_) {
+    std::memcpy(dst, source, static_cast<size_t>(page_count) << page_size_log2_);
+    return true;
+  }
+  const size_t page_size = static_cast<size_t>(1) << page_size_log2_;
+  u32 run_first = 0;
+  const auto copy_run = [&](u32 run_end) {
+    if (run_end > run_first) {
+      std::memcpy(dst + (static_cast<size_t>(run_first) << page_size_log2_),
+                  source + (static_cast<size_t>(run_first) << page_size_log2_),
+                  static_cast<size_t>(run_end - run_first) << page_size_log2_);
+    }
+  };
+  for (u32 i = 0; i < page_count; ++i) {
+    if (!IsPageHot(page_first + i)) {
+      continue;
+    }
+    copy_run(i);
+    // What the comparison at the next request is made against.
+    std::memcpy(dst + (static_cast<size_t>(i) << page_size_log2_),
+                GetHotPageShadow(page_first + i), page_size);
+    run_first = i + 1;
+  }
+  copy_run(page_count);
+  return true;
+}
+
+void SharedMemory::FilterHotPageUploads() {
+  const size_t page_size = static_cast<size_t>(1) << page_size_log2_;
+  const u32 max_hot_pages = kMaxHotPageBytes >> page_size_log2_;
+  hot_page_upload_ranges_.clear();
+  const auto include = [this](u32 page_start, u32 page_count) {
+    if (!hot_page_upload_ranges_.empty()) {
+      std::pair<u32, u32>& last = hot_page_upload_ranges_.back();
+      if (last.first + last.second == page_start) {
+        last.second += page_count;
+        return;
+      }
+    }
+    hot_page_upload_ranges_.emplace_back(page_start, page_count);
+  };
+  for (const std::pair<u32, u32>& range : upload_ranges_) {
+    const u8* guest_range = GetPhysicalForRead(physical_memory_, range.first << page_size_log2_,
+                                               range.second << page_size_log2_);
+    if (!guest_range) {
+      include(range.first, range.second);  // UploadRanges reports it.
+      continue;
+    }
+    for (u32 i = 0; i < range.second; ++i) {
+      const u32 page = range.first + i;
+      const u8* guest = guest_range + (static_cast<size_t>(i) << page_size_log2_);
+      if (IsPageHot(page)) {
+        page_last_request_frame_[page] = hot_page_frame_;
+        u8* shadow = GetHotPageShadow(page);
+        if (std::memcmp(guest, shadow, page_size) == 0) {
+          if (hot_page_frame_ - page_last_change_frame_[page] > kHotPageUnchangedFrames) {
+            // Static now: uploaded and protected like any other page.
+            MakePageNotHot(page, true);
+            include(page, 1);
+          }
+          continue;
+        }
+        std::memcpy(shadow, guest, page_size);
+        page_last_change_frame_[page] = hot_page_frame_;
+        // No access violation reports this write, so tell the global watches here.
+        const u32 address = page << page_size_log2_;
+        for (const auto& global_watch : global_watches_) {
+          global_watch->callback(global_watch->callback_context, address,
+                                 address + static_cast<u32>(page_size) - 1, false);
+        }
+        include(page, 1);
+        continue;
+      }
+      const u32 last_request_frame = page_last_request_frame_[page];
+      if (last_request_frame != hot_page_frame_) {
+        u8& streak = page_upload_streak_[page];
+        streak = last_request_frame + 1 == hot_page_frame_
+                     ? static_cast<u8>(std::min<u32>(streak + 1u, 255u))
+                     : static_cast<u8>(1);
+        page_last_request_frame_[page] = hot_page_frame_;
+        if (streak >= kHotPageUploadStreak && hot_page_count_ < max_hot_pages &&
+            page_watch_count_[page] == 0 && page_shadow_slot_[page] == kNoShadow) {
+          page_shadow_slot_[page] = AllocateHotPageShadow();
+          std::memcpy(GetHotPageShadow(page), guest, page_size);
+          hot_pages_[page >> 6] |= static_cast<u64>(1) << (page & 63);
+          ++hot_page_count_;
+          page_last_change_frame_[page] = hot_page_frame_;
+        }
+      }
+      include(page, 1);
+    }
+  }
+  upload_ranges_.swap(hot_page_upload_ranges_);
+}
