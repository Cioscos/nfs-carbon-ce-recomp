+void XenosGraphicsDriverBase::DeliverVblankNow() {
+  std::lock_guard lock(vblank_mutex_);
+  MarkVblank();
+  // Not more than the timer catches up on: a title that presents faster than the refresh
+  // rate gets its timer blanks back soon after it stops presenting.
+  if (early_vblanks_ < kMaxVblankCatchUp) {
+    ++early_vblanks_;
+  }
+}
